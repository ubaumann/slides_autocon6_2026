{
  "openapi": "3.1.0",
  "info": {
    "title": "ERSPAN API",
    "description": "Simple example of an API for AutoCon6",
    "version": "1.0.0"
  },
  "paths": {
    "/erspan-sessions": {
      "get": {
        "summary": "List Sessions",
        "operationId": "list_sessions_erspan_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ErspanSession"
                  },
                  "type": "array",
                  "title": "Response List Sessions Erspan Sessions Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Session",
        "operationId": "create_session_erspan_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErspanSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErspanSession"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/erspan-sessions/{name}": {
      "get": {
        "summary": "Get Session",
        "operationId": "get_session_erspan_sessions__name__get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErspanSession"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Session",
        "operationId": "update_session_erspan_sessions__name__put",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErspanSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErspanSession"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Session",
        "operationId": "delete_session_erspan_sessions__name__delete",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/schemas/erspan-session.json": {
      "get": {
        "summary": "Get Erspan Schema",
        "operationId": "get_erspan_schema_schemas_erspan_session_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Erspan Schema Schemas Erspan Session Json Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorModel": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "ErrorModel"
      },
      "ErspanDestination": {
        "properties": {
          "ip_address": {
            "type": "string",
            "format": "ipvanyaddress",
            "title": "Ip Address"
          },
          "origin_ip_address": {
            "type": "string",
            "format": "ipvanyaddress",
            "title": "Origin Ip Address"
          },
          "erspan_id": {
            "type": "integer",
            "maximum": 1023.0,
            "minimum": 1.0,
            "title": "Erspan Id"
          },
          "vrf": {
            "type": "string",
            "title": "Vrf",
            "default": "default"
          },
          "ttl": {
            "type": "integer",
            "maximum": 255.0,
            "minimum": 1.0,
            "title": "Ttl",
            "default": 64
          },
          "dscp": {
            "type": "integer",
            "maximum": 63.0,
            "minimum": 0.0,
            "title": "Dscp",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ip_address",
          "origin_ip_address",
          "erspan_id"
        ],
        "title": "ErspanDestination"
      },
      "ErspanSession": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 32,
            "title": "Description",
            "default": ""
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "source": {
            "$ref": "#/components/schemas/ErspanSource"
          },
          "destination": {
            "$ref": "#/components/schemas/ErspanDestination"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "source",
          "destination"
        ],
        "title": "ErspanSession"
      },
      "ErspanSource": {
        "properties": {
          "interfaces": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Interfaces"
          },
          "direction": {
            "type": "string",
            "enum": [
              "rx",
              "tx",
              "both"
            ],
            "title": "Direction",
            "default": "both"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "interfaces"
        ],
        "title": "ErspanSource"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
